{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "accent": "#f5c2e7",
    "base": "#1e1e2e",
    "blue": "#89b4fa",
    "crust": "#11111b",
    "flamingo": "#f2cdcd",
    "green": "#a6e3a1",
    "lavender": "#b4befe",
    "mantle": "#181825",
    "maroon": "#eba0ac",
    "mauve": "#cba6f7",
    "overlay0": "#6c7086",
    "overlay1": "#7f849c",
    "overlay2": "#9399b2",
    "peach": "#fab387",
    "pink": "#f5c2e7",
    "red": "#f38ba8",
    "rosewater": "#f5e0dc",
    "sapphire": "#74c7ec",
    "sky": "#89dceb",
    "subtext0": "#a6adc8",
    "subtext1": "#bac2de",
    "surface0": "#313244",
    "surface1": "#45475a",
    "surface2": "#585b70",
    "teal": "#94e2d5",
    "text": "#cdd6f4",
    "yellow": "#f9e2af"
  },
  "transient_prompt": {
    "template": " \uf460 ",
    "foreground": "p:text"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "template": "\u256d", "foreground": "p:overlay0", "type": "text", "style": "plain" },
        { "options": { "fedora": "\uF30a" }, "template": "{{ .Icon }} ", "foreground": "p:lavender", "type": "os", "style": "plain" },
        { "template": "\uf0e7 ", "foreground": "p:red", "type": "root", "style": "plain" },
        { "template": "{{ if or .Root (not (has .UserName (list \"jgatz\" \"licht\" \"gatzw\" \"jens\"))) }}<d>{{ .UserName }}</d> {{ end }}{{ if .SSHSession }}<p:flamingo>\udb82\udcb9 {{ .HostName }}</> {{ end }}", "foreground": "p:rosewater", "type": "session", "style": "plain" },
        { "options": { "mapped_locations": { "/mnt/d/Projects": "\uf502 ", "D:/Projects": "\uf502 ", "~/Projects": "\uf502 " }, "style": "full" }, "template": "<i>{{ .Path }}</i> ", "foreground": "p:pink", "type": "path", "style": "plain" },
        { "options": { "branch_ahead_icon": "\udb80\udc5d", "branch_behind_icon": "\udb80\udc45", "branch_gone_icon": "\udb80\udcf9", "branch_icon": "\uf418 ", "branch_identical_icon": "", "cherry_pick_icon": "\ue29b ", "commit_icon": "\udb81\udf18 ", "fetch_status": true, "fetch_upstream_icon": true, "merge_icon": "\udb81\ude2d ", "no_commits_icon": "\ueae4 ", "rebase_icon": "\ue728 ", "revert_icon": "\ueb8e ", "tag_icon": "\udb81\udcf9 " }, "template": "{{ .UpstreamIcon }} {{ .HEAD }} {{ if .BranchStatus }}{{ .BranchStatus }} {{ end }}{{ if .Working.Changed }}{{ .Working.String }} {{ end }}{{ if .Staging.Changed }}{{ .Staging.String }} {{ end }}", "foreground": "p:peach", "type": "git", "style": "plain" },
        { "template": "\uf487 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Version }}{{.Version}} {{ end }}{{ end }}", "foreground": "p:yellow", "type": "project", "style": "plain" },
        { "template": "\ue615 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ", "foreground": "p:sapphire", "type": "cmake", "style": "plain" },
        { "options": { "extensions": ["package.json"] }, "template": "{{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}\udb80\udf99 {{ .Full }} ", "foreground": "p:green", "type": "node", "style": "plain" },
        { "options": { "extensions": ["package-lock.json"] }, "template": "\ued0e {{ .Full }}", "foreground": "p:peach", "type": "npm", "style": "plain" },
        { "options": { "extensions": ["pnpm-lock.yaml"] }, "template": "\ue865 {{ .Full }} ", "foreground": "p:red", "type": "pnpm", "style": "plain" },
        { "options": { "extensions": ["deno.json"] }, "template": "\udb82\udeb0 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ", "foreground": "p:green", "type": "deno", "style": "plain" },
        { "template": "\uef79 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}", "foreground": "p:flamingo", "type": "bun", "style": "plain" },
        { "template": "\udb83\udcd0 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ", "foreground": "p:lavender", "type": "nx", "style": "plain" },
        { "template": "\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }} {{ end }}", "foreground": "p:yellow", "type": "python", "style": "plain" },
        { "template": "\ue68b {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} ", "foreground": "p:flamingo", "type": "rust", "style": "plain" },
        { "template": "{{ if .Env.IN_NIX_SHELL }}\uf313 {{ .Env.name }} {{ end }}", "foreground": "p:blue", "type": "text", "style": "plain" },
        { "template": "\udb82\udd54 {{ .FormattedMs }} ", "foreground": "p:overlay0", "type": "executiontime", "style": "plain" }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        { "options": { "cache_duration": "none" }, "template": "\u2570", "foreground": "p:overlay0", "type": "text", "style": "plain" },
        { "options": { "cache_duration": "none" }, "template": "\uf460", "foreground": "p:text", "type": "text", "style": "plain", "foreground_templates": ["{{if gt .Code 0}}p:red{{end}}", "{{if eq .Code 0}}p:green{{end}}"] }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
